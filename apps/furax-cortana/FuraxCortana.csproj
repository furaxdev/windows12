<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Requis pour compiler un TFM "-windows" depuis un SDK hébergé sur Linux (build
         croisé) : sans ça, le SDK refuse de restaurer/compiler par sécurité. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FuraxCortana</AssemblyName>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Moteur d'inférence locale (llama.cpp via binding C#), MIT — aucun appel réseau à
         l'exécution, aucune télémétrie. Voir Program.cs pour l'explication complète du
         choix et des limites honnêtes (pas de modèle fourni, pas de voix en MVP). -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
  </ItemGroup>

</Project>

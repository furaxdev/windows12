<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FuraxSetupWizard</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fond d'écran embarqué DANS l'exe (ressource compilée), pas un fichier externe à
         côté — évite toute dépendance de chemin relatif dans l'environnement WinPE
         minimal au moment du boot, où la disposition exacte des fichiers déposés peut
         différer de celle du dépôt source. -->
    <EmbeddedResource Include="..\..\assets\wallpapers\furax-wave-primary.jpg" LogicalName="wave.jpg" />
  </ItemGroup>

</Project>

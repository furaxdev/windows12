#!/usr/bin/env bash
# osh — OpenConnect Shell (sans ngrok, sans SSH — relay Supabase HTTPS)
# Usage : osh --ip={hôte}@{user} [--password={secret}] {commande}
#
# L'hôte est ignoré pour le routage (tout passe par Supabase) — il sert
# juste d'identifiant visuel. Le serveur doit tourner sur le PC cible avec
# le même secret.
#
# Exemples :
#   osh --ip=monpc@furax "ls -la ~"
#   osh --ip=monpc@furax --password=MonSecret "./vm/launch-viewer.sh"
#   osh --ip=monpc@furax --timeout=15 "commande rapide"
#   osh --ip=monpc@furax                         # shell interactif

set -euo pipefail

SUPABASE_URL="https://vohddkxqdeivqcoogtzd.supabase.co"
ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZvaGRka3hxZGVpdnFjb29ndHpkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2MjExNDMsImV4cCI6MjEwNDE5NzE0M30.nDc8h92CQi9x_US4FqzQN-mSL29VyRzsqKmNeLTVJLs"
POLL_INTERVAL=1   # seconde entre chaque poll résultat
TIMEOUT=60        # secondes avant abandon (surchargeable avec --timeout=N)

C_RESET='\033[0m'; C_CYAN='\033[0;36m'; C_GREEN='\033[0;32m'
C_YELLOW='\033[1;33m'; C_RED='\033[0;31m'; C_MAGENTA='\033[0;35m'
C_GRAY='\033[0;90m'; C_BOLD='\033[1m'

usage() {
  echo -e "
  ${C_BOLD}osh${C_RESET} — OpenConnect Shell (relay Supabase, sans ngrok ni SSH)

  ${C_CYAN}Usage :${C_RESET}
    osh --ip={hôte}@{user} [--password={secret}] [--timeout={secondes}] [commande]

  ${C_CYAN}Exemples :${C_RESET}
    osh --ip=monpc@furax \"ls -la ~\"
    osh --ip=monpc@furax --password=MonSecret \"./vm/launch-viewer.sh\"
    osh --ip=monpc@furax --timeout=15 \"echo rapide\"
    osh --ip=monpc@furax              # shell interactif (60s de timeout par défaut)
"
  exit 1
}

# ─── Args ────────────────────────────────────────────────────────────────────
IP_USER=""; PASSWORD=""; CMD=""
for arg in "$@"; do
  case "$arg" in
    --ip=*)       IP_USER="${arg#--ip=}"        ;;
    --password=*) PASSWORD="${arg#--password=}" ;;
    --timeout=*)  TIMEOUT="${arg#--timeout=}"   ;;
    --help|-h)    usage ;;
    -*)           echo "Option inconnue : $arg" >&2; usage ;;
    *)            CMD="$arg" ;;
  esac
done
[[ -z "$IP_USER" ]] && usage
if ! [[ "$TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "--timeout doit être un entier (secondes) : $TIMEOUT" >&2
  exit 1
fi

HOST="${IP_USER%%@*}"
USER_PART="${IP_USER##*@}"
[[ "$HOST" == "$IP_USER" ]] && USER_PART="?"

# ─── Secret ──────────────────────────────────────────────────────────────────
if [[ -z "$PASSWORD" ]]; then
  echo -ne "  ${C_CYAN}${USER_PART}@${HOST}${C_RESET} — secret : "
  read -rs PASSWORD; echo ""
fi

SECRET_HASH=$(python3 -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" "$PASSWORD")

# ─── Helpers curl ────────────────────────────────────────────────────────────
supa_post() {
  local path="$1" body="$2"
  curl -sf -X POST "$SUPABASE_URL/rest/v1/$path" \
    -H "apikey: $ANON_KEY" \
    -H "Authorization: Bearer $ANON_KEY" \
    -H "Content-Type: application/json" \
    -H "Prefer: return=representation" \
    -d "$body"
}

supa_get() {
  local path="$1"
  curl -sf "$SUPABASE_URL/rest/v1/$path" \
    -H "apikey: $ANON_KEY" \
    -H "Authorization: Bearer $ANON_KEY"
}

supa_delete() {
  local path="$1"
  curl -sf -X DELETE "$SUPABASE_URL/rest/v1/$path" \
    -H "apikey: $ANON_KEY" \
    -H "Authorization: Bearer $ANON_KEY" > /dev/null
}

# ─── Envoi + attente résultat ────────────────────────────────────────────────
run_remote() {
  local cmd="$1"

  # Insertion de la commande
  local payload
  payload=$(python3 -c "
import json,sys
print(json.dumps({'secret_hash': sys.argv[1], 'cmd': sys.argv[2]}))
" "$SECRET_HASH" "$cmd")

  local row
  row=$(supa_post "osh_queue" "$payload") || {
    echo -e "  ${C_RED}✗ Impossible d'envoyer la commande (Supabase inaccessible ?)${C_RESET}" >&2
    return 1
  }

  local row_id
  row_id=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])[0]['id'])" "$row" 2>/dev/null) || {
    echo -e "  ${C_RED}✗ Réponse inattendue : $row${C_RESET}" >&2
    return 1
  }

  echo -e "  ${C_GRAY}↑ envoyé [id ${row_id:0:8}…] — attente du serveur…${C_RESET}"

  # Poll résultat
  local elapsed=0
  while true; do
    sleep "$POLL_INTERVAL"
    elapsed=$((elapsed + POLL_INTERVAL))

    local result
    result=$(supa_get "osh_queue?id=eq.${row_id}&select=status,stdout,stderr,returncode") || continue

    local status
    status=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d[0]['status'] if d else 'pending')" "$result" 2>/dev/null || echo "pending")

    if [[ "$status" == "done" ]]; then
      python3 - "$result" <<'PYEOF'
import json, sys
d = json.loads(sys.argv[1])[0]
stdout = d.get("stdout", "")
stderr = d.get("stderr", "")
rc     = d.get("returncode", 0)
if stdout: print(stdout, end="")
if stderr: print(f"\033[1;33m{stderr}\033[0m", end="", file=sys.stderr)
sys.exit(0 if rc == 0 else rc)
PYEOF
      local rc=$?
      supa_delete "osh_queue?id=eq.${row_id}" 2>/dev/null || true
      return $rc
    fi

    if [[ $elapsed -ge $TIMEOUT ]]; then
      echo -e "  ${C_RED}✗ Timeout (${TIMEOUT}s) — le serveur répond-il ?${C_RESET}" >&2
      supa_delete "osh_queue?id=eq.${row_id}" 2>/dev/null || true
      return 1
    fi
  done
}

# ─── Mode commande directe ───────────────────────────────────────────────────
echo -e "  ${C_GREEN}✓ osh connecté via Supabase — ${USER_PART}@${HOST}${C_RESET}"
echo ""

if [[ -n "$CMD" ]]; then
  run_remote "$CMD"
  exit $?
fi

# ─── Mode shell interactif ───────────────────────────────────────────────────
echo -e "  ${C_MAGENTA}osh interactif${C_RESET} ${C_GRAY}(exit ou Ctrl+D pour quitter)${C_RESET}"
echo ""
while true; do
  echo -ne "${C_CYAN}${USER_PART}@${HOST}${C_RESET}:${C_BOLD}\$${C_RESET} "
  if ! read -r CMD; then echo ""; break; fi
  [[ -z "$CMD" ]] && continue
  [[ "$CMD" == "exit" || "$CMD" == "quit" ]] && break
  run_remote "$CMD" || true
done

echo -e "  ${C_GRAY}Session fermée.${C_RESET}"
